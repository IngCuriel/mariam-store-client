# Variables de entorno de la tienda en línea
#
# Los valores públicos por ambiente viven en .env.dev y .env.prod (versionados).
# Los secretos van en .env.dev.local / .env.prod.local (ignorados por git),
# que Vite carga por encima de .env.dev / .env.prod.

# API key de Pexels para imágenes de productos (opcional, secreto)
# VITE_PEXELS_API_KEY=tu_api_key_aqui

# Variables que define cada ambiente (ver .env.dev y .env.prod)
# VITE_APP_ENV=   (dev muestra la barra "Ambiente de pruebas"; prod no muestra nada)
# VITE_API_URL=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
